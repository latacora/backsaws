<?xml version="1.0" encoding="UTF-8"?>
<!-- The template `b/write-pom` synchronizes from: it defaults :src-pom to ./pom.xml, so
     what is here ends up in the built jar's pom. groupId, artifactId, version and the
     dependency and repository lists are replaced from build.clj and deps.edn; the rest of
     this file is not, which is why it is worth keeping accurate. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.latacora</groupId>
  <artifactId>backsaws</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>com.latacora/backsaws</name>
  <description>Behind-the-scenes AWS: pagination, credential providers and the other things aws-api leaves to its callers.</description>
  <url>https://github.com/latacora/backsaws</url>
  <licenses>
    <license>
      <name>Eclipse Public License</name>
      <url>http://www.eclipse.org/legal/epl-v10.html</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Lvh</name>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/latacora/backsaws</url>
    <connection>scm:git:git://github.com/latacora/backsaws.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/latacora/backsaws.git</developerConnection>
    <tag>v0.1.0-SNAPSHOT</tag>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>clojure</artifactId>
      <version>1.12.5</version>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>src</sourceDirectory>
  </build>
  <repositories>
    <repository>
      <id>clojars</id>
      <url>https://repo.clojars.org/</url>
    </repository>
    <repository>
      <id>sonatype</id>
      <url>https://oss.sonatype.org/content/repositories/snapshots/</url>
    </repository>
  </repositories>
  <distributionManagement>
    <repository>
      <id>clojars</id>
      <name>Clojars repository</name>
      <url>https://clojars.org/repo</url>
    </repository>
  </distributionManagement>
</project>
